# Copy to .env for local development. Never commit .env.
# Chat requires a key; without it /api/chat returns 503 AI_NOT_CONFIGURED.
ANTHROPIC_API_KEY=

# Optional: base URL for an Anthropic-compatible provider endpoint.
# Leave unset to use https://api.anthropic.com.
# ANTHROPIC_BASE_URL=

# Model ID used by the agent.
ANTHROPIC_MODEL=claude-opus-5-5

# Patient used when /api/chat omits patient_id.
DEFAULT_PATIENT_ID=P001

# Loopback REST base URL used by the agent's tool client.
BACKEND_BASE_URL=http://127.0.0.1:8000

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Application log level.
LOG_LEVEL=INFO
